# Copy this file to .env and fill in the real values. Never commit .env.
DISCORD_TOKEN=
DISCORD_GUILD_ID=
SUNFLOWER_DB_PATH=
LOG_LEVEL=

# Painel administrativo (opcional). Sem PANEL_PUBLIC_URL o painel fica desligado
# e o bot sobe normalmente. Para ligar, descomente e preencha as seis variáveis.
# PANEL_PUBLIC_URL=https://painel.example.com
# PANEL_PORT=3000
# DISCORD_CLIENT_ID=111111111111111111
# DISCORD_CLIENT_SECRET=troque-por-um-segredo
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# SESSION_SECRET=troque-por-um-segredo
# Proxies confiáveis, separados por vírgula. Vazio = nenhum.
# ATENÇÃO: atrás de Caddy/Nginx na mesma máquina, use 127.0.0.1; num túnel, use o IP do
# conector. Vazio, todos os clientes parecem vir do proxy e dividem os mesmos limites de
# requisições (uma pessoa pode bloquear o login de todas).
# PANEL_TRUST_PROXY=127.0.0.1
