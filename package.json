{
  "name": "sun-flower",
  "version": "0.3.0",
  "private": true,
  "description": "Modular Discord bot dedicated to a single community server.",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env interfaces/discord/main.ts",
    "staff": "node --env-file-if-exists=.env core/application/staff.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "app:install": "npm ci --prefix interfaces/dashboard/app",
    "app:check": "npm run check --prefix interfaces/dashboard/app",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run app:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "@fastify/websocket": "^11.3.7",
    "discord.js": "^14.28.1",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  }
}
